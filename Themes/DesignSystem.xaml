<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ct="using:CommunityToolkit.WinUI.Controls" xmlns:controls="using:ScreenRecorderApp.Views.Controls">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="WorkspaceBrush" Color="#0D0F12"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#111318"/>
            <SolidColorBrush x:Key="ElevatedBrush" Color="#181B21"/>
            <SolidColorBrush x:Key="StageBrush" Color="#0A0C0F"/>
            <SolidColorBrush x:Key="SubtleBorderBrush" Color="#262C35"/>
            <SolidColorBrush x:Key="PreviewTextBrush" Color="#B9C1D1"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#27D7E7"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="WorkspaceBrush" Color="#F3F5F8"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ElevatedBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="StageBrush" Color="#E7EBF1"/>
            <SolidColorBrush x:Key="SubtleBorderBrush" Color="#18000000"/>
            <SolidColorBrush x:Key="PreviewTextBrush" Color="#535F74"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#087F91"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="WorkspaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="ElevatedBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="StageBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="SubtleBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="PreviewTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <controls:CompactNumberConverter x:Key="CompactNumber"/>
    <x:Double x:Key="SpaceXS">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">12</x:Double>
    <x:Double x:Key="SpaceL">16</x:Double>
    <x:Double x:Key="SpaceXL">20</x:Double>
    <x:Double x:Key="SpaceXXL">24</x:Double>
    <x:Double x:Key="SpaceXXXL">32</x:Double>
    <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">12</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">16</CornerRadius>
    <CornerRadius x:Key="RadiusXL">20</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ComboBoxPopupCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ComboBoxItemCornerRadius">8</CornerRadius>
    <Thickness x:Key="ComboBoxItemThemePadding">12,8</Thickness>
    <Thickness x:Key="ComboBoxPopupBorderThemeThickness">1</Thickness>
    <x:Double x:Key="ControlHeightCompact">32</x:Double>
    <x:Double x:Key="ControlHeightDefault">40</x:Double>
    <x:Double x:Key="ControlHeightLarge">48</x:Double>
    <!-- Retain the native templates, keyboard behavior, focus states, popup animation and high contrast. -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,8,36,8"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,8"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style TargetType="ct:SettingsCard">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource SubtleBorderBrush}"/>
    </Style>
    <Style TargetType="ct:SettingsExpander">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}"/>
    </Style>
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource SubtleBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="14"/>
    </Style>
    <Style x:Key="SectionDescriptionText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="SectionHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="NumberBox">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="PillItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="InspectorTabStyle" TargetType="GridViewItem">
        <Setter Property="Padding" Value="6,8"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="InspectorSurfaceStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="14"/>
    </Style>
    <Style x:Key="InspectorLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CharacterSpacing" Value="80"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Style>
    <Style x:Key="SegmentedStyle" TargetType="ListBox">
        <Setter Property="Background" Value="{ThemeResource StageBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource PillItemStyle}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
