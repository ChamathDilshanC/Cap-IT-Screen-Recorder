<Page
    x:Class="ScreenRecorderApp.Views.CapturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="SectionDescriptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28" Spacing="18" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="Capture" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="What to record, at what quality, and how the cursor is rendered. (A quick display/window switcher also lives on the Home tab, right next to the preview it affects.)"
                           Style="{StaticResource SectionDescriptionText}" />
            </StackPanel>

            <ctcontrols:SettingsExpander Header="Target" Description="Display, quality, and cursor rendering" IsExpanded="True">
                <ctcontrols:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;" />
                </ctcontrols:SettingsExpander.HeaderIcon>
                <ctcontrols:SettingsExpander.Items>
                    <ctcontrols:SettingsCard Header="Choose visually"
                                              Description="{x:Bind ViewModel.CurrentTargetSummary, Mode=OneWay}">
                        <ctcontrols:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE71D;" />
                        </ctcontrols:SettingsCard.HeaderIcon>
                        <Button Click="OnChooseSourceClick" Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7F4;" FontSize="14" />
                                <TextBlock Text="Choose source" />
                            </StackPanel>
                        </Button>
                    </ctcontrols:SettingsCard>

                    <ctcontrols:SettingsCard Header="Capture mode" Description="Record the entire display, or just one application window">
                        <ComboBox MinWidth="180"
                            ItemsSource="{x:Bind ViewModel.CaptureTargetKindOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedCaptureTargetKind, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                    </ctcontrols:SettingsCard>

                    <ctcontrols:SettingsCard Header="Display" Description="Monitor to capture"
                                              Visibility="{x:Bind ViewModel.IsMonitorCaptureMode, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox MinWidth="260"
                                ItemsSource="{x:Bind ViewModel.Monitors}"
                                SelectedItem="{x:Bind ViewModel.SelectedMonitor, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                            <Button Command="{x:Bind ViewModel.RefreshMonitorsCommand}"
                                    ToolTipService.ToolTip="Refresh displays">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </ctcontrols:SettingsCard>

                    <ctcontrols:SettingsCard Header="Window"
                                              Description="Which window to capture — overlapping windows are excluded, even if they're on top"
                                              Visibility="{x:Bind ViewModel.IsWindowCaptureMode, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox MinWidth="320"
                                ItemsSource="{x:Bind ViewModel.Windows}"
                                SelectedItem="{x:Bind ViewModel.SelectedWindow, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                            <Button Command="{x:Bind ViewModel.RefreshWindowsCommand}"
                                    ToolTipService.ToolTip="Refresh windows">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </ctcontrols:SettingsCard>

                    <ctcontrols:SettingsCard Header="Frame rate">
                        <ComboBox MinWidth="140"
                            ItemsSource="{x:Bind ViewModel.FpsOptions}"
                            SelectedItem="{x:Bind ViewModel.Fps, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                    </ctcontrols:SettingsCard>

                    <ctcontrols:SettingsCard Header="Encoder" Description="Hardware encoder to use, when available">
                        <ComboBox MinWidth="180"
                            ItemsSource="{x:Bind ViewModel.EncoderOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedEncoder, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                    </ctcontrols:SettingsCard>

                    <ctcontrols:SettingsCard Header="Maximize text clarity"
                                              Description="4:4:4 color (no blur/fringing around text edges) at a higher preset for sharper detail. Noticeably larger files; only applies with Auto/Software (x264) — hardware encoders don't support it."
                                              Visibility="{x:Bind ViewModel.CanMaximizeTextClarity, Mode=OneWay}">
                        <ToggleSwitch OnContent="On" OffContent="Off"
                                      IsOn="{x:Bind ViewModel.MaximizeTextClarity, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                    </ctcontrols:SettingsCard>

                    <ctcontrols:SettingsCard Header="Video bitrate" Description="{x:Bind ViewModel.BitrateLabel, Mode=OneWay}">
                        <Slider MinWidth="220"
                            Minimum="2000" Maximum="40000" StepFrequency="500"
                            Value="{x:Bind ViewModel.VideoBitrateKbps, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                    </ctcontrols:SettingsCard>

                    <ctcontrols:SettingsCard Header="Quality" Description="Output resolution, independent of the captured resolution">
                        <ComboBox MinWidth="220"
                            ItemsSource="{x:Bind ViewModel.ResolutionOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedResolution, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                    </ctcontrols:SettingsCard>

                    <ctcontrols:SettingsCard Header="Output format">
                        <ComboBox MinWidth="140"
                            ItemsSource="{x:Bind ViewModel.ContainerOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedContainer, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                    </ctcontrols:SettingsCard>

                    <!-- Cursor rendering is composited per frame, so unlike the encoder settings above
                         these two apply instantly — to the live preview and to a recording already running. -->
                    <ctcontrols:SettingsCard Header="Show cursor"
                                              Description="Applies immediately, even mid-recording">
                        <ToggleSwitch OnContent="On" OffContent="Off"
                                      IsOn="{x:Bind ViewModel.CaptureCursor, Mode=TwoWay}" />
                    </ctcontrols:SettingsCard>

                    <ctcontrols:SettingsCard Header="Cursor style"
                                              Description="Only applies when recording the entire display — window capture always shows the real system cursor, with no style choice"
                                              Visibility="{x:Bind ViewModel.CaptureCursor, Mode=OneWay}">
                        <ComboBox MinWidth="200"
                            ItemsSource="{x:Bind ViewModel.CursorStyleOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedCursorStyle, Mode=TwoWay}" />
                    </ctcontrols:SettingsCard>
                </ctcontrols:SettingsExpander.Items>
            </ctcontrols:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
