<ContentDialog
    x:Class="ScreenRecorderApp.Views.SourcePickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ScreenRecorderApp.ViewModels"
    Title="Choose what to record"
    PrimaryButtonText="Select and record"
    SecondaryButtonText="Select"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <!-- ContentDialog clips its content to these theme resources — they default to 548x756, which
             silently cut the right-hand column of tiles off entirely. They're sized to fit inside the
             smallest window MainWindow permits (1100x600, see MinWindowWidth/MinWindowHeight there), so
             the picker can never overflow its own host no matter how small the app window is. -->
        <x:Double x:Key="ContentDialogMaxWidth">980</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">660</x:Double>

        <!-- One template for both grids: a display tile and a window tile differ only in what the two
             label lines say, so there's nothing for a second template to do. -->
        <DataTemplate x:Key="SourceTileTemplate" x:DataType="vm:CaptureSourceItem">
            <Grid Width="178" Padding="6" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Height="92" CornerRadius="6" Background="#FF141018"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Image Source="{x:Bind Thumbnail}" Stretch="Uniform"
                               Visibility="{x:Bind HasThumbnail, Mode=OneWay}" />
                        <!-- Shown only until the first successful capture lands, so a tile is never a
                             frame of uninitialized black pretending to be a preview. -->
                        <ProgressRing IsActive="True" Width="22" Height="22"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="{x:Bind IsLoadingThumbnail, Mode=OneWay}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Spacing="1">
                    <TextBlock Text="{x:Bind Title}" FontSize="12.5" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock Text="{x:Bind Subtitle}" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Tiles are wide (16:9 thumbnail plus two lines of label); the default GridView item container
             sizes itself to a much smaller square, so it needs stretching to fit the template. -->
        <Style x:Key="SourceTileContainerStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="GroupHeaderText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </ContentDialog.Resources>

    <!-- MaxHeight, not a fixed Height: with a fixed height the content overflows ContentDialog's own
         clip at small window sizes and gets cut off rather than scrolled. Sizing to content up to a cap
         lets the star row (the ScrollViewer) absorb the overflow and scroll it instead. -->
    <Grid Width="840" MaxHeight="470" MinHeight="300" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                       Text="Every tile below is live. Pick a whole display, or a single window — a window is captured on its own, so anything stacked on top of it stays out of the recording." />
            <Button Grid.Column="1" Click="OnRescanClick" VerticalAlignment="Center"
                    ToolTipService.ToolTip="Rescan for displays and windows">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Rescan" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7F4;" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="Displays" Style="{StaticResource GroupHeaderText}" VerticalAlignment="Center" />
                </StackPanel>

                <GridView x:Name="ScreensGrid"
                          ItemsSource="{x:Bind Screens}"
                          SelectionMode="Single"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionChanged="OnScreenSelectionChanged"
                          ItemContainerStyle="{StaticResource SourceTileContainerStyle}"
                          ItemTemplate="{StaticResource SourceTileTemplate}" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <FontIcon Glyph="&#xE737;" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="Windows" Style="{StaticResource GroupHeaderText}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="NoWindowsText"
                           Text="No open windows were found. Minimized windows can't be captured — restore one and press Rescan."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                           TextWrapping="Wrap" Visibility="Collapsed" />

                <GridView x:Name="WindowsGrid"
                          ItemsSource="{x:Bind WindowSources}"
                          SelectionMode="Single"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionChanged="OnWindowSelectionChanged"
                          ItemContainerStyle="{StaticResource SourceTileContainerStyle}"
                          ItemTemplate="{StaticResource SourceTileTemplate}" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="SelectionSummary"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</ContentDialog>
