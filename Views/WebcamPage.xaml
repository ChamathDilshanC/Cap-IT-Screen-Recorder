<Page
    x:Class="ScreenRecorderApp.Views.WebcamPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="SectionDescriptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28" Spacing="18" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="Webcam" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="A circular picture-in-picture webcam overlay for your recordings."
                           Style="{StaticResource SectionDescriptionText}" />
            </StackPanel>

            <ctcontrols:SettingsExpander Header="Webcam overlay" Description="Shown as a circular overlay on top of the recording" IsExpanded="True">
                <ctcontrols:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE722;" />
                </ctcontrols:SettingsExpander.HeaderIcon>
                <ToggleSwitch OnContent="On" OffContent="Off"
                              IsOn="{x:Bind ViewModel.WebcamEnabled, Mode=TwoWay}" />
                <ctcontrols:SettingsExpander.Items>
                    <ctcontrols:SettingsCard Header="Camera" Description="Which webcam to overlay">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox MinWidth="260"
                                ItemsSource="{x:Bind ViewModel.Webcams}"
                                SelectedItem="{x:Bind ViewModel.SelectedWebcam, Mode=TwoWay}" />
                            <Button Command="{x:Bind ViewModel.RefreshWebcamsCommand}"
                                    ToolTipService.ToolTip="Refresh webcams">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </ctcontrols:SettingsCard>
                    <ctcontrols:SettingsCard Header="Webcam template" Description="Choose a frame style. The preview below shows how it will look in the recording.">
                        <StackPanel Spacing="10">
                            <ComboBox MinWidth="260"
                                      ItemsSource="{x:Bind ViewModel.WebcamTemplateOptions}"
                                      SelectedItem="{x:Bind ViewModel.SelectedWebcamTemplate, Mode=TwoWay}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedWebcamTemplate.Label, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Tag="circle" Click="OnTemplateClick" Padding="8">
                                    <StackPanel Spacing="4">
                                        <Ellipse Width="56" Height="56" Fill="#FF536D8A" Stroke="#FFB7C9E2" StrokeThickness="3" />
                                        <TextBlock Text="Circle" HorizontalAlignment="Center" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="rounded" Click="OnTemplateClick" Padding="8">
                                    <StackPanel Spacing="4">
                                        <Border Width="56" Height="56" Background="#FF536D8A" CornerRadius="14" BorderBrush="#FFB7C9E2" BorderThickness="3" />
                                        <TextBlock Text="Rounded" HorizontalAlignment="Center" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="square" Click="OnTemplateClick" Padding="8">
                                    <StackPanel Spacing="4">
                                        <Border Width="56" Height="56" Background="#FF536D8A" BorderBrush="#FFB7C9E2" BorderThickness="3" />
                                        <TextBlock Text="Square" HorizontalAlignment="Center" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="landscape" Click="OnTemplateClick" Padding="8">
                                    <StackPanel Spacing="4">
                                        <Border Width="70" Height="48" Background="#FF536D8A" CornerRadius="8" BorderBrush="#FFB7C9E2" BorderThickness="3" />
                                        <TextBlock Text="Landscape" HorizontalAlignment="Center" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="neon" Click="OnTemplateClick" Padding="8">
                                    <StackPanel Spacing="4">
                                        <Ellipse Width="56" Height="56" Fill="#FF536D8A" Stroke="#FFE052FF" StrokeThickness="4" />
                                        <TextBlock Text="Neon ring" HorizontalAlignment="Center" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ctcontrols:SettingsCard>
                </ctcontrols:SettingsExpander.Items>
            </ctcontrols:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
