<Page
    x:Class="ScreenRecorderApp.Views.EffectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="SectionDescriptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28" Spacing="18" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="Cursor Effects" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Extra polish for where the viewer's eye should go."
                           Style="{StaticResource SectionDescriptionText}" />
            </StackPanel>

            <ctcontrols:SettingsExpander Header="Spotlight" Description="Dims the rest of the screen, leaving a sharp circle around the cursor" IsExpanded="True">
                <ctcontrols:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE81E;" />
                </ctcontrols:SettingsExpander.HeaderIcon>
                <!-- Not gated on IsIdle like most capture settings: the spotlight is applied per frame
                     at composite time, so both of these now take effect on the live preview and on an
                     in-progress recording the moment they change. -->
                <ToggleSwitch OnContent="On" OffContent="Off"
                              IsOn="{x:Bind ViewModel.SpotlightEnabled, Mode=TwoWay}" />
                <ctcontrols:SettingsExpander.Items>
                    <ctcontrols:SettingsCard Header="Spotlight radius"
                                              Description="{x:Bind ViewModel.SpotlightRadiusLabel, Mode=OneWay}">
                        <Slider MinWidth="220"
                            Minimum="80" Maximum="600" StepFrequency="10"
                            Value="{x:Bind ViewModel.SpotlightRadius, Mode=TwoWay}" />
                    </ctcontrols:SettingsCard>
                </ctcontrols:SettingsExpander.Items>
            </ctcontrols:SettingsExpander>

            <ctcontrols:SettingsCard Header="Click ripples" Description="A brief expanding ring wherever you click, left or right">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7C9;" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <ToggleSwitch OnContent="On" OffContent="Off"
                              IsOn="{x:Bind ViewModel.ClickRipplesEnabled, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
            </ctcontrols:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
