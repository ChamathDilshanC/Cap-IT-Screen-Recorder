<Page
    x:Class="ScreenRecorderApp.Views.AnnotationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:ScreenRecorderApp.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="SectionDescriptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28" Spacing="18" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="Annotations" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Draw on screen while recording to call out what matters."
                           Style="{StaticResource SectionDescriptionText}" />
            </StackPanel>

            <ctcontrols:SettingsCard Header="Enable annotations"
                                      Description="Puts a transparent overlay over the selected display right away — you don't have to be recording. Toggle Drawing Mode with the hotkey below to draw; whatever you draw is part of the desktop itself, so it's captured in the recording automatically — no extra setup needed.">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE70F;" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <ToggleSwitch OnContent="On" OffContent="Off"
                              IsOn="{x:Bind ViewModel.AnnotationsEnabled, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.CanToggleAnnotations, Mode=OneWay}" />
            </ctcontrols:SettingsCard>

            <TextBlock Text="Only available when recording the entire display — window capture only sees that one window's own contents, not the overlay drawn on top of it."
                       Style="{StaticResource SectionDescriptionText}"
                       Visibility="{x:Bind ViewModel.IsWindowCaptureMode, Mode=OneWay}" />

            <ctcontrols:SettingsCard Header="Hotkeys"
                                      Description="Active across the whole desktop the moment annotations are switched on — you don't need this app focused, or a recording running."
                                      Visibility="{x:Bind ViewModel.AnnotationsEnabled, Mode=OneWay}">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE765;" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Right">
                    <TextBlock Text="Ctrl + Shift + D  —  toggle Drawing Mode" FontSize="13" />
                    <TextBlock Text="Ctrl + Shift + Z  —  undo last stroke" FontSize="13" />
                    <TextBlock Text="Esc  —  clear drawings" FontSize="13" />
                </StackPanel>
            </ctcontrols:SettingsCard>

            <ctcontrols:SettingsCard Header="Pen color"
                                      Description="Applies immediately, even mid-recording — switch colors without losing anything already drawn."
                                      Visibility="{x:Bind ViewModel.AnnotationsEnabled, Mode=OneWay}">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <ComboBox MinWidth="180"
                    ItemsSource="{x:Bind ViewModel.AnnotationColorOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedAnnotationColor, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:AnnotationColorOption">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="14" Height="14" CornerRadius="3"
                                        Background="{x:Bind Brush}"
                                        BorderBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                        BorderThickness="1" />
                                <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </ctcontrols:SettingsCard>

            <ctcontrols:SettingsCard Header="Stroke thickness"
                                      Description="{x:Bind ViewModel.AnnotationStrokeThicknessLabel, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.AnnotationsEnabled, Mode=OneWay}">
                <Slider MinWidth="220" Minimum="2" Maximum="20" StepFrequency="1"
                        Value="{x:Bind ViewModel.AnnotationStrokeThickness, Mode=TwoWay}" />
            </ctcontrols:SettingsCard>

            <ctcontrols:SettingsCard Header="Drawing tools"
                                      Description="A floating toolbar appears on the recorded display while Drawing Mode is on — Pen, Line, Arrow, Rectangle, Ellipse and a click-to-type Text tool, plus the colours and thickness. Drag it anywhere; it never appears in the recording or the live preview, only what you draw with it does."
                                      Visibility="{x:Bind ViewModel.AnnotationsEnabled, Mode=OneWay}">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE70F;" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <TextBlock Text="{x:Bind ViewModel.SelectedAnnotationToolLabel, Mode=OneWay}" FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </ctcontrols:SettingsCard>

            <TextBlock Text="While Drawing Mode is on, the overlay captures your clicks — toggle it back off with Ctrl+Shift+D to interact with the apps underneath. With the Text tool, click where you want a label and just type; Enter adds a line, Esc places it."
                       Style="{StaticResource SectionDescriptionText}"
                       Visibility="{x:Bind ViewModel.AnnotationsEnabled, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
