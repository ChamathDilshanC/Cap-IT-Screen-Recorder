<Page
    x:Class="ScreenRecorderApp.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ScreenRecorderApp.Views.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Page.Resources>

    <!-- Kept deliberately minimal: the live preview, a quick capture-target switcher, and the record
         controls. Everything else (audio/output settings, tracking settings) lives on its own
         NavigationView tab — the target switcher is duplicated here (not moved) since it's the one
         Settings-tab control worth having right next to the preview it immediately affects. -->
    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Status bar -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center"
                          Fill="{ThemeResource SystemFillColorCriticalBrush}"
                          Visibility="{x:Bind ViewModel.IsRecording, Mode=OneWay}" />
                <Ellipse Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center"
                          Fill="{ThemeResource SystemFillColorCautionBrush}"
                          Visibility="{x:Bind ViewModel.IsPaused, Mode=OneWay}" />

                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}"
                           FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"
                           FontFamily="Consolas" />

                <!-- Live mic + speaker level meters — visible whenever their respective source is enabled,
                     whether or not a recording is actually running, so a signal (or its absence) is
                     obvious before you ever press Start Recording. See MainViewModel.UpdateMicLevel/
                     UpdateSpeakerLevel and MicLevelMonitorService/SpeakerLevelMonitorService. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.ShowMicMeter, Mode=OneWay}">
                        <FontIcon Glyph="&#xE720;" FontSize="14"
                                  Foreground="{x:Bind ViewModel.MicMeterBrush, Mode=OneWay}" />
                        <controls:LevelMeter VerticalAlignment="Center"
                                             Level="{x:Bind ViewModel.MicLevel, Mode=OneWay}"
                                             IsAvailable="{x:Bind ViewModel.IsMicMonitorAvailable, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.MicStatusText, Mode=OneWay}" FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.ShowSpeakerMeter, Mode=OneWay}">
                        <FontIcon Glyph="&#xE767;" FontSize="14"
                                  Foreground="{x:Bind ViewModel.SpeakerMeterBrush, Mode=OneWay}" />
                        <controls:LevelMeter VerticalAlignment="Center"
                                             Level="{x:Bind ViewModel.SpeakerLevel, Mode=OneWay}"
                                             IsAvailable="{x:Bind ViewModel.IsSpeakerMonitorAvailable, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.SpeakerStatusText, Mode=OneWay}" FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Right"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <!-- Quick target switcher — same ViewModel properties SettingsPage's capture-target card already
             binds to (CaptureTargetKindOptions/SelectedCaptureTargetKind, Monitors/SelectedMonitor,
             Windows/SelectedWindow), just surfaced here too so switching between "Entire display" and a
             specific window doesn't require leaving the tab you're actually watching the live preview
             from. Changing it re-triggers the same RestartPreviewIfIdle() the Settings page's controls
             already do, so the preview updates immediately — hence disabled (not hidden) while
             recording/paused, matching every other capture-target control in the app. -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,16">
            <StackPanel Spacing="10">
                <!-- The visual picker: live thumbnails of every display and window, so you can see what
                     you're about to record instead of guessing from a window title. The dropdowns below
                     stay as the fast path once you already know which source you want. -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Click="OnChooseSourceClick"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7F4;" FontSize="14" />
                            <TextBlock Text="Choose source" />
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Text="{x:Bind ViewModel.CurrentTargetSummary, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <ComboBox MinWidth="150"
                    ItemsSource="{x:Bind ViewModel.CaptureTargetKindOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedCaptureTargetKind, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />

                <ComboBox MinWidth="220"
                    Visibility="{x:Bind ViewModel.IsMonitorCaptureMode, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.Monitors}"
                    SelectedItem="{x:Bind ViewModel.SelectedMonitor, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                <Button Visibility="{x:Bind ViewModel.IsMonitorCaptureMode, Mode=OneWay}"
                        Command="{x:Bind ViewModel.RefreshMonitorsCommand}"
                        ToolTipService.ToolTip="Refresh displays">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>

                <ComboBox MinWidth="260"
                    Visibility="{x:Bind ViewModel.IsWindowCaptureMode, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.Windows}"
                    SelectedItem="{x:Bind ViewModel.SelectedWindow, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                <Button Visibility="{x:Bind ViewModel.IsWindowCaptureMode, Mode=OneWay}"
                        Command="{x:Bind ViewModel.RefreshWindowsCommand}"
                        ToolTipService.ToolTip="Refresh windows">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
            </StackPanel>
        </Border>

        <!-- Live preview -->
        <Border Grid.Row="2" CornerRadius="12" Background="#FF0B0B0F">
            <Grid>
                <Image x:Name="PreviewImage"
                       Stretch="Uniform"
                       Visibility="{x:Bind ViewModel.HasPreview, Mode=OneWay}" />

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                            Visibility="{x:Bind ViewModel.ShowPlaceholder, Mode=OneWay}">
                    <Image Source="ms-appx:///assets/Logo-CapIT.png" Width="72" Height="72" Opacity="0.85" />
                    <TextBlock Text="Pick a display or window above to see a live preview"
                               HorizontalAlignment="Center" Foreground="#FFB9B9C2" />
                </StackPanel>

                <!-- ffmpeg setup banner: appears when Start Recording is pressed but ffmpeg.exe isn't installed -->
                <Border Visibility="{x:Bind ViewModel.ShowFFmpegSetupBanner, Mode=OneWay}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="18" Margin="16"
                        HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="440">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="ffmpeg setup" Style="{StaticResource SectionHeaderText}" />
                        </StackPanel>

                        <TextBlock Text="{x:Bind ViewModel.FfmpegSetupMessage, Mode=OneWay}" TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    Visibility="{x:Bind ViewModel.FfmpegSetupRequired, Mode=OneWay}">
                            <Button Content="Download" Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.ConfirmDownloadFFmpegCommand}" />
                            <Button Content="Cancel" Command="{x:Bind ViewModel.CancelFFmpegSetupCommand}" />
                        </StackPanel>

                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsDownloadingFFmpeg, Mode=OneWay}">
                            <ProgressBar Value="{x:Bind ViewModel.FfmpegDownloadProgress, Mode=OneWay}"
                                         Minimum="0" Maximum="100" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.FFmpegDownloadProgressText, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Cancel" Command="{x:Bind ViewModel.CancelFFmpegDownloadCommand}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14" Margin="0,18,0,0">
            <Button Command="{x:Bind ViewModel.StartRecordingCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="30,14" CornerRadius="24"
                    Visibility="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE7C8;" FontSize="17" />
                    <TextBlock Text="Start Recording" FontSize="17" />
                </StackPanel>
            </Button>

            <Button Command="{x:Bind ViewModel.PauseResumeCommand}"
                    Padding="22,12" CornerRadius="20"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="{x:Bind ViewModel.PauseResumeGlyph, Mode=OneWay}" FontSize="14" />
                    <TextBlock Text="{x:Bind ViewModel.PauseResumeButtonText, Mode=OneWay}" FontSize="15" />
                </StackPanel>
            </Button>

            <Button Command="{x:Bind ViewModel.StopRecordingCommand}"
                    Padding="22,12" CornerRadius="20"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                    <TextBlock Text="Stop" FontSize="15" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="Cap-IT Screen Recorder · Developed by Chamath Dilshan"
                   HorizontalAlignment="Center" Margin="0,14,0,0"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" />
    </Grid>
</Page>
