<Window
    x:Class="ScreenRecorderApp.Views.AnnotationOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background="Transparent" (not unset) is required: WinUI still composites an opaque root visual
         by default, and only an explicit Transparent brush combined with WS_EX_LAYERED (applied in
         code-behind) actually lets the desktop show through. -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- The actual drawing surface (Step 2). Windows App SDK has no InkCanvas/InkPresenter for
             desktop apps (that's UWP-only), so strokes are hand-rolled: each pointer drag becomes a
             Polyline added to this Canvas in code-behind. Background="Transparent" is required here, not
             just on RootGrid — a Panel with no Background at all is NOT hit-test visible in its empty
             area (only its children are), so without an explicit (if invisible) brush, pointer input
             would only ever land exactly on an already-drawn Polyline instead of anywhere on the overlay,
             and the very first stroke could never start at all. -->
        <Canvas x:Name="DrawSurface" Background="Transparent" />

        <!-- Small always-visible indicator of drawing-mode state — kept from Step 1 rather than removed
             now that real ink exists, since it's the only on-screen cue for whether clicks currently hit
             the overlay (drawing) or pass through to whatever's underneath (click-through). -->
        <Border x:Name="StatusPill"
                Background="#C8202020"
                CornerRadius="6"
                Padding="12,6"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,24,24,0">
            <TextBlock x:Name="StatusText"
                       Text="Drawing Mode: Off"
                       Foreground="White"
                       FontSize="13"
                       FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
