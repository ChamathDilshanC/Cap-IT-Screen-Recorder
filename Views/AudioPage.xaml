<Page
    x:Class="ScreenRecorderApp.Views.AudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="SectionDescriptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28" Spacing="18" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="Audio Enhancement" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="AI-assisted microphone cleanup. (Basic system audio/microphone toggles stay on the Settings tab — this is about improving mic quality, not choosing sources.)"
                           Style="{StaticResource SectionDescriptionText}" />
            </StackPanel>

            <ctcontrols:SettingsCard Header="Studio Mic (Noise Suppression)"
                                      Description="Removes background hum, fan noise, and keyboard clicks from your microphone via FFmpeg's afftdn/highpass filters. Only ever applied to the mic — system/game audio is left untouched."
                                      Visibility="{x:Bind ViewModel.CaptureMicrophone, Mode=OneWay}">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE767;" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <ToggleSwitch OnContent="On" OffContent="Off"
                              IsOn="{x:Bind ViewModel.EnableMicNoiseSuppression, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
            </ctcontrols:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
