<Page
    x:Class="ScreenRecorderApp.Views.AudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="SectionDescriptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28" Spacing="18" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="Audio" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Which audio sources to record, and AI-assisted microphone cleanup."
                           Style="{StaticResource SectionDescriptionText}" />
            </StackPanel>

            <ctcontrols:SettingsExpander Header="Sources" Description="System sound and microphone" IsExpanded="True">
                <ctcontrols:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE767;" />
                </ctcontrols:SettingsExpander.HeaderIcon>
                <ctcontrols:SettingsExpander.Items>
                    <ctcontrols:SettingsCard Header="Record system audio">
                        <ToggleSwitch OnContent="On" OffContent="Off"
                                      IsOn="{x:Bind ViewModel.CaptureSystemAudio, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                    </ctcontrols:SettingsCard>

                    <ctcontrols:SettingsCard Header="Record microphone">
                        <ToggleSwitch OnContent="On" OffContent="Off"
                                      IsOn="{x:Bind ViewModel.CaptureMicrophone, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                    </ctcontrols:SettingsCard>

                    <ctcontrols:SettingsCard Header="Microphone device">
                        <ComboBox MinWidth="260"
                            ItemsSource="{x:Bind ViewModel.Microphones}"
                            SelectedItem="{x:Bind ViewModel.SelectedMicrophone, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                    </ctcontrols:SettingsCard>
                </ctcontrols:SettingsExpander.Items>
            </ctcontrols:SettingsExpander>

            <ctcontrols:SettingsCard Header="Studio Mic (Noise Suppression)"
                                      Description="Removes background hum, fan noise, and keyboard clicks from your microphone via FFmpeg's afftdn/highpass filters. Only ever applied to the mic — system/game audio is left untouched."
                                      Visibility="{x:Bind ViewModel.CaptureMicrophone, Mode=OneWay}">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE767;" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <ToggleSwitch OnContent="On" OffContent="Off"
                              IsOn="{x:Bind ViewModel.EnableMicNoiseSuppression, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
            </ctcontrols:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
