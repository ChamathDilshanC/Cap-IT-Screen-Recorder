<Page
    x:Class="ScreenRecorderApp.Views.AudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:ScreenRecorderApp.Views.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="SectionDescriptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28" Spacing="18" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="Audio" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Which audio sources to record, and AI-assisted microphone cleanup."
                           Style="{StaticResource SectionDescriptionText}" />
            </StackPanel>

            <ctcontrols:SettingsExpander Header="Sources" Description="System sound and microphone" IsExpanded="True">
                <ctcontrols:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE767;" />
                </ctcontrols:SettingsExpander.HeaderIcon>
                <ctcontrols:SettingsExpander.Items>
                    <!-- Switchable mid-recording: both sources feed one mixer behind a single ffmpeg
                         audio pipe, so a source can be added or dropped without restarting the encode.
                         See MainViewModel.CanChangeAudioLive for the two cases where it can't. -->
                    <ctcontrols:SettingsCard Header="Record system audio"
                                              Description="Applies immediately, even mid-recording">
                        <ToggleSwitch OnContent="On" OffContent="Off"
                                      IsOn="{x:Bind ViewModel.CaptureSystemAudio, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.CanChangeAudioLive, Mode=OneWay}" />
                    </ctcontrols:SettingsCard>

                    <ctcontrols:SettingsCard Header="Record microphone"
                                              Description="Applies immediately, even mid-recording">
                        <ToggleSwitch OnContent="On" OffContent="Off"
                                      IsOn="{x:Bind ViewModel.CaptureMicrophone, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.CanChangeAudioLive, Mode=OneWay}" />
                    </ctcontrols:SettingsCard>

                    <ctcontrols:SettingsCard Header="Microphone device"
                                              Description="Can be swapped mid-recording too">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox MinWidth="260"
                                ItemsSource="{x:Bind ViewModel.Microphones}"
                                SelectedItem="{x:Bind ViewModel.SelectedMicrophone, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.CanChangeAudioLive, Mode=OneWay}" />
                            <Button Command="{x:Bind ViewModel.RefreshMicrophonesCommand}"
                                    ToolTipService.ToolTip="Refresh microphones">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </ctcontrols:SettingsCard>

                    <!-- Live level readouts, mirroring the Home tab's — the mic device is picked right
                         above, so this is where you most want to confirm the choice was the right one
                         without leaving the tab to go look. -->
                    <ctcontrols:SettingsCard Header="Microphone level"
                                              Description="Speak to check the level — talk toward the red end and you'll clip"
                                              Visibility="{x:Bind ViewModel.ShowMicMeter, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <controls:LevelMeter VerticalAlignment="Center" SegmentCount="20"
                                                 MinSegmentHeight="6" MaxSegmentHeight="22"
                                                 Level="{x:Bind ViewModel.MicLevel, Mode=OneWay}"
                                                 IsAvailable="{x:Bind ViewModel.IsMicMonitorAvailable, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.MicStatusText, Mode=OneWay}" FontSize="12"
                                       MinWidth="90" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ctcontrols:SettingsCard>

                    <ctcontrols:SettingsCard Header="System audio level"
                                              Description="Play something to check that system sound is being picked up"
                                              Visibility="{x:Bind ViewModel.ShowSpeakerMeter, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <controls:LevelMeter VerticalAlignment="Center" SegmentCount="20"
                                                 MinSegmentHeight="6" MaxSegmentHeight="22"
                                                 Level="{x:Bind ViewModel.SpeakerLevel, Mode=OneWay}"
                                                 IsAvailable="{x:Bind ViewModel.IsSpeakerMonitorAvailable, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.SpeakerStatusText, Mode=OneWay}" FontSize="12"
                                       MinWidth="90" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ctcontrols:SettingsCard>
                </ctcontrols:SettingsExpander.Items>
            </ctcontrols:SettingsExpander>

            <ctcontrols:SettingsCard Header="Studio Mic (Noise Suppression)"
                                      Description="Removes background hum, fan noise, and keyboard clicks from your microphone via FFmpeg's afftdn/highpass filters. Only ever applied to the mic — system/game audio is left untouched."
                                      Visibility="{x:Bind ViewModel.CaptureMicrophone, Mode=OneWay}">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE767;" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <ToggleSwitch OnContent="On" OffContent="Off"
                              IsOn="{x:Bind ViewModel.EnableMicNoiseSuppression, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
            </ctcontrols:SettingsCard>

            <TextBlock Text="The audio sources above are locked for this recording: it was started with no audio at all, or with noise suppression on both sources — in either case FFmpeg's audio graph was fixed when the recording began. Stop and start again to change them."
                       Style="{StaticResource SectionDescriptionText}"
                       Visibility="{x:Bind ViewModel.ShowAudioLockedHint, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
