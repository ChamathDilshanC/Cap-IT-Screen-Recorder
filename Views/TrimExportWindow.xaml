<Window
    x:Class="ScreenRecorderApp.Views.TrimExportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">

    <Grid Padding="24" RowSpacing="16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Recording complete" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="FilePathText" Opacity="0.7" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Grid Grid.Row="1" MinHeight="320" x:Name="PreviewCanvas" Background="#15151A"
              SizeChanged="PreviewCanvas_SizeChanged">
            <Image x:Name="PreviewBackground" Stretch="UniformToFill" Opacity="0.98" />
            <Border x:Name="PreviewVideoFrame" Width="900" Height="506"
                    MaxWidth="1200" MaxHeight="675" Margin="24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="Black" BorderBrush="#55FFFFFF" BorderThickness="1"
                    CornerRadius="0" Padding="0">
                <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="True"
                                    Stretch="Uniform" HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch" />
            </Border>

            <!-- Replaces the player outright when playback fails, rather than sitting on top of it: the
                 element renders its own bare "Error: Video could not be decoded" text, which says nothing
                 about whether the recording is actually usable. See ShowPlaybackError. -->
            <Border x:Name="PlaybackErrorPanel" Visibility="Collapsed"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="28">
                <StackPanel Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
                    <FontIcon Glyph="&#xE7BA;" FontSize="28" HorizontalAlignment="Left" />
                    <TextBlock x:Name="PlaybackErrorTitle"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="PlaybackErrorDetail"
                               Opacity="0.8" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="Post-record editor" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="CanvasPresetComboBox" Header="Output canvas"
                          SelectionChanged="CanvasPreset_SelectionChanged" />
                <ComboBox x:Name="BackgroundPresetComboBox" Header="Background image"
                          Grid.Column="1"
                          SelectionChanged="BackgroundPreset_SelectionChanged" />
                <Button Grid.Column="2" Content="Choose image…" Click="OnChooseBackgroundClick"
                        VerticalAlignment="Bottom" />
                <Slider Grid.Column="3" x:Name="VideoScaleSlider" Header="Video scale"
                        Minimum="0.55" Maximum="1" StepFrequency="0.05" Value="0.82"
                        Width="180" ValueChanged="VideoScale_ValueChanged" />
            </Grid>
            <Slider x:Name="CornerRadiusSlider" Header="Rounded corners" Minimum="0" Maximum="48"
                    StepFrequency="2" Value="18" ValueChanged="CornerRadius_ValueChanged" />
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="4">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TrimStartText" Text="00:00.0" VerticalAlignment="Center" />
                <ctcontrols:RangeSelector x:Name="TrimRange" Grid.Column="1"
                                          Minimum="0" Maximum="1" StepFrequency="0.1"
                                          ValueChanged="TrimRange_ValueChanged" />
                <TextBlock Grid.Column="2" x:Name="TrimEndText" Text="00:00.0" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="TrimStatusText" Text="Selected: 0.0s" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel x:Name="ExportProgressPanel" Grid.Row="4" Spacing="4" Visibility="Collapsed">
            <TextBlock x:Name="ExportStageText" Text="Generating palette…" FontSize="12" />
            <ProgressBar x:Name="ExportProgress" Minimum="0" Maximum="100" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="DiscardButton" Content="Discard" Click="OnDiscardClick" />
            <Button x:Name="ExportGifButton" Content="Export GIF" Click="OnExportGifClick" />
            <Button x:Name="SaveButton" Content="Export MP4" Style="{StaticResource AccentButtonStyle}" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
