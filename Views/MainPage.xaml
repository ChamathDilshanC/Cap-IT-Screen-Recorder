<Page
    x:Class="ScreenRecorderApp.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shapes="using:Microsoft.UI.Xaml.Shapes"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Padding="20" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Settings panel -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="2,0,0,4">
                    <Image Source="ms-appx:///assets/Logo-CapIT.png" Width="34" Height="34" />
                    <TextBlock Text="Cap-IT Screen Recorder" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Capture card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7F4;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Capture" Style="{StaticResource SectionHeaderText}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Display" Style="{StaticResource FieldLabel}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                    ItemsSource="{x:Bind ViewModel.Monitors}"
                                    SelectedItem="{x:Bind ViewModel.SelectedMonitor, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                    HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" Command="{x:Bind ViewModel.RefreshMonitorsCommand}"
                                        ToolTipService.ToolTip="Refresh displays">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Frame rate" Style="{StaticResource FieldLabel}" />
                                <ComboBox
                                    ItemsSource="{x:Bind ViewModel.FpsOptions}"
                                    SelectedItem="{x:Bind ViewModel.Fps, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                    HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Encoder" Style="{StaticResource FieldLabel}" />
                                <ComboBox
                                    ItemsSource="{x:Bind ViewModel.EncoderOptions}"
                                    SelectedItem="{x:Bind ViewModel.SelectedEncoder, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                    HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.BitrateLabel, Mode=OneWay}" Style="{StaticResource FieldLabel}" />
                            <Slider
                                Minimum="2000" Maximum="40000" StepFrequency="500"
                                Value="{x:Bind ViewModel.VideoBitrateKbps, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Quality" Style="{StaticResource FieldLabel}" />
                                <ComboBox
                                    ItemsSource="{x:Bind ViewModel.ResolutionOptions}"
                                    SelectedItem="{x:Bind ViewModel.SelectedResolution, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                    HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Output format" Style="{StaticResource FieldLabel}" />
                                <ComboBox
                                    ItemsSource="{x:Bind ViewModel.ContainerOptions}"
                                    SelectedItem="{x:Bind ViewModel.SelectedContainer, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                    HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <ToggleSwitch Header="Show cursor" OnContent="On" OffContent="Off"
                                      IsOn="{x:Bind ViewModel.CaptureCursor, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />

                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.CaptureCursor, Mode=OneWay}">
                            <TextBlock Text="Cursor style" Style="{StaticResource FieldLabel}" />
                            <ComboBox
                                ItemsSource="{x:Bind ViewModel.CursorStyleOptions}"
                                SelectedItem="{x:Bind ViewModel.SelectedCursorStyle, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Audio card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE767;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Audio" Style="{StaticResource SectionHeaderText}" />
                        </StackPanel>

                        <ToggleSwitch Header="Record system audio" OnContent="On" OffContent="Off"
                                      IsOn="{x:Bind ViewModel.CaptureSystemAudio, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />

                        <ToggleSwitch Header="Record microphone" OnContent="On" OffContent="Off"
                                      IsOn="{x:Bind ViewModel.CaptureMicrophone, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Microphone device" Style="{StaticResource FieldLabel}" />
                            <ComboBox
                                ItemsSource="{x:Bind ViewModel.Microphones}"
                                SelectedItem="{x:Bind ViewModel.SelectedMicrophone, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Output card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Output" Style="{StaticResource SectionHeaderText}" />
                        </StackPanel>

                        <TextBox Header="Save recordings to"
                                  Text="{x:Bind ViewModel.OutputDirectory, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                        <Button Content="Open output folder" Command="{x:Bind ViewModel.OpenOutputFolderCommand}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Status bar -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center"
                              Fill="{ThemeResource SystemFillColorCriticalBrush}"
                              Visibility="{x:Bind ViewModel.IsRecording, Mode=OneWay}" />
                    <Ellipse Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center"
                              Fill="{ThemeResource SystemFillColorCautionBrush}"
                              Visibility="{x:Bind ViewModel.IsPaused, Mode=OneWay}" />

                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}"
                               FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"
                               FontFamily="Consolas" />

                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Right"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>

            <!-- Live preview -->
            <Border Grid.Row="1" CornerRadius="12" Background="#FF0B0B0F">
                <Grid>
                    <Image x:Name="PreviewImage"
                           Stretch="Uniform"
                           Visibility="{x:Bind ViewModel.HasPreview, Mode=OneWay}" />

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                                Visibility="{x:Bind ViewModel.ShowPlaceholder, Mode=OneWay}">
                        <Image Source="ms-appx:///assets/Logo-CapIT.png" Width="72" Height="72" Opacity="0.85" />
                        <TextBlock Text="Select a display to see a live preview"
                                   HorizontalAlignment="Center" Foreground="#FFB9B9C2" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14" Margin="0,18,0,0">
                <Button Command="{x:Bind ViewModel.StartRecordingCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="22,12" CornerRadius="20"
                        Visibility="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7C8;" FontSize="15" />
                        <TextBlock Text="Start Recording" FontSize="15" />
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.PauseResumeCommand}"
                        Padding="22,12" CornerRadius="20"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="{x:Bind ViewModel.PauseResumeGlyph, Mode=OneWay}" FontSize="14" />
                        <TextBlock Text="{x:Bind ViewModel.PauseResumeButtonText, Mode=OneWay}" FontSize="15" />
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.StopRecordingCommand}"
                        Padding="22,12" CornerRadius="20"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71A;" FontSize="14" />
                        <TextBlock Text="Stop" FontSize="15" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Grid.Row="3" Text="Cap-IT Screen Recorder · Developed by Chamath Dilshan"
                       HorizontalAlignment="Center" Margin="0,14,0,0"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" />
        </Grid>
    </Grid>
</Page>
