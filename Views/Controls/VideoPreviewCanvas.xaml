<UserControl x:Class="ScreenRecorderApp.Views.Controls.VideoPreviewCanvas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource StageBrush}" Padding="24">
        <Viewbox Stretch="Uniform">
            <Canvas x:Name="CompositionCanvas" Width="1920" Height="1080">
                <Image x:Name="BackgroundLayer" Stretch="Fill" Width="1920" Height="1080" />
                <Canvas x:Name="VideoViewport">
                    <MediaPlayerElement x:Name="VideoPlayer" AreTransportControlsEnabled="False" Stretch="Fill" />
                </Canvas>
                <Image x:Name="OverlayLayer" Stretch="Fill" IsHitTestVisible="False" />
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
