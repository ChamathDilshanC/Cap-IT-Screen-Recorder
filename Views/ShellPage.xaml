<Page
    x:Class="ScreenRecorderApp.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource WorkspaceBrush}">

    <NavigationView x:Name="RootNavigationView"
                     PaneDisplayMode="Auto"
                     IsBackButtonVisible="Collapsed"
                     IsSettingsVisible="False"
                     OpenPaneLength="224"
                     CompactPaneLength="56"
                     CompactModeThresholdWidth="900"
                     ExpandedModeThresholdWidth="1180"
                     PaneTitle=""
                     SelectionChanged="OnSelectionChanged"
                     Loaded="OnNavigationViewLoaded">

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Home" Tag="Home" IsSelected="True">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE80F;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Capture" Tag="Capture">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7F4;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Smart Tracking" Tag="Tracking">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE721;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Webcam" Tag="Webcam">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE722;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Annotations" Tag="Annotations">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE70F;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Effects" Tag="Effects">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE81E;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Audio" Tag="Audio">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE767;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Settings" Tag="Settings">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.PaneHeader>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,8,0,8">
                <Border Width="28" Height="28" CornerRadius="8" Background="{ThemeResource AccentBrush}">
                    <Image Source="ms-appx:///assets/Logo-Mark.png" Width="20" Height="20" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="Cap-IT" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Screen recorder" FontSize="10" Opacity=".6"/>
                </StackPanel>
            </StackPanel>
        </NavigationView.PaneHeader>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Auto-update banner (GitHub Releases). Shown app-wide, not per-tab, so it's visible
                 wherever the user happens to be. See MainViewModel.CheckForUpdatesAsync / UpdateService. -->
            <InfoBar Grid.Row="0" Margin="12,12,12,0"
                     Severity="Success"
                     Title="Update available"
                     IsClosable="True"
                     IsOpen="{x:Bind ViewModel.UpdateAvailable, Mode=TwoWay}"
                     Message="{x:Bind ViewModel.UpdateBannerMessage, Mode=OneWay}">
                <InfoBar.Content>
                    <Grid Margin="0,4,0,12">
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    Visibility="{x:Bind ViewModel.IsNotDownloadingUpdate, Mode=OneWay}">
                            <Button Content="Update now" Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.UpdateNowCommand}" />
                            <Button Content="Release notes"
                                    Command="{x:Bind ViewModel.ViewReleaseNotesCommand}" />
                        </StackPanel>

                        <StackPanel Spacing="6"
                                    Visibility="{x:Bind ViewModel.IsDownloadingUpdate, Mode=OneWay}">
                            <TextBlock Text="Downloading update…" FontSize="12" />
                            <ProgressBar Width="280" Minimum="0" Maximum="100"
                                         Value="{x:Bind ViewModel.UpdateDownloadProgress, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.UpdateDownloadProgressText, Mode=OneWay}"
                                           FontSize="12" VerticalAlignment="Center" />
                                <Button Content="Cancel" Command="{x:Bind ViewModel.CancelUpdateDownloadCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </InfoBar.Content>
            </InfoBar>

            <Frame x:Name="ContentFrame" Grid.Row="1" />
        </Grid>
    </NavigationView>
</Page>
