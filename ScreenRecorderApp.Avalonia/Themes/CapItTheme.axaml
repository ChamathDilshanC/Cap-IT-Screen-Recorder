<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <Color x:Key="CapItBlue">#27D7E7</Color>
    <Color x:Key="CapItNavy">#0D0F12</Color>
    <Color x:Key="CapItWorkspace">#101319</Color>
    <Color x:Key="CapItSurface">#171A20</Color>
    <Color x:Key="CapItSurfaceRaised">#1D2128</Color>
    <Color x:Key="CapItMutedText">#A8B0BC</Color>
    <SolidColorBrush x:Key="CapItBackgroundBrush" Color="{DynamicResource CapItNavy}" />
    <SolidColorBrush x:Key="CapItWorkspaceBrush" Color="{DynamicResource CapItWorkspace}" />
    <SolidColorBrush x:Key="CapItSurfaceBrush" Color="{DynamicResource CapItSurface}" />
    <SolidColorBrush x:Key="CapItSurfaceRaisedBrush" Color="{DynamicResource CapItSurfaceRaised}" />
    <SolidColorBrush x:Key="CapItAccentBrush" Color="{DynamicResource CapItBlue}" />
    <SolidColorBrush x:Key="CapItMutedTextBrush" Color="{DynamicResource CapItMutedText}" />
    <SolidColorBrush x:Key="CapItBorderBrush" Color="#344054" />
    <Thickness x:Key="CapItCardPadding">20</Thickness>
    <CornerRadius x:Key="CapItCardRadius">10</CornerRadius>
  </Styles.Resources>
  <Style Selector="Button.rail">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#D0D5DD" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="Button.rail:pointerover">
    <Setter Property="Background" Value="{DynamicResource CapItSurfaceRaisedBrush}" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource CapItAccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Padding" Value="16,10" />
  </Style>
  <Style Selector="TextBox,ComboBox,NumericUpDown">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Slider">
    <Setter Property="MinHeight" Value="28" />
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource CapItSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CapItBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CapItCardRadius}" />
  </Style>
</Styles>
