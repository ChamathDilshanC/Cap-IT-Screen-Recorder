<!--
  PROPOSED brand tokens (Midnight / Arctic Precision) — generated by brand/source/build_tokens.py.
  NOT referenced by the application. To trial: merge into Styles/Colors.axaml under the matching
  ThemeDictionaries key and point individual Brush.* aliases at the Brand.* brushes one at a time.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="Brand.BgApp" Color="#09111D" />
      <SolidColorBrush x:Key="Brand.BgSecondary" Color="#101C2B" />
      <SolidColorBrush x:Key="Brand.SurfaceLayer1" Color="#142633" />
      <SolidColorBrush x:Key="Brand.SurfaceLayer2" Color="#1B3042" />
      <SolidColorBrush x:Key="Brand.SurfaceLayer3" Color="#243D52" />
      <SolidColorBrush x:Key="Brand.FgPrimary" Color="#F5F9FC" />
      <SolidColorBrush x:Key="Brand.FgSecondary" Color="#93A8B9" />
      <SolidColorBrush x:Key="Brand.FgMuted" Color="#8398A7" />
      <SolidColorBrush x:Key="Brand.FgDisabled" Color="#4F6578" />
      <SolidColorBrush x:Key="Brand.BrandPrimary" Color="#18DCE8" />
      <SolidColorBrush x:Key="Brand.BrandPrimaryHover" Color="#4BE6EE" />
      <SolidColorBrush x:Key="Brand.BrandPrimaryPressed" Color="#12B7C2" />
      <SolidColorBrush x:Key="Brand.BrandOnPrimary" Color="#04141A" />
      <SolidColorBrush x:Key="Brand.BrandSecondary" Color="#7C5CFF" />
      <SolidColorBrush x:Key="Brand.BrandSecondaryText" Color="#9B82FF" />
      <SolidColorBrush x:Key="Brand.BrandSecondarySolid" Color="#7958FF" />
      <SolidColorBrush x:Key="Brand.BrandSecondaryOnSolid" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Brand.BorderSubtle" Color="#294050" />
      <SolidColorBrush x:Key="Brand.Divider" Color="#203443" />
      <SolidColorBrush x:Key="Brand.BorderControl" Color="#527188" />
      <SolidColorBrush x:Key="Brand.StatusInfo" Color="#6AA8FF" />
      <SolidColorBrush x:Key="Brand.StatusSuccess" Color="#10B981" />
      <SolidColorBrush x:Key="Brand.StatusWarning" Color="#F59E0B" />
      <SolidColorBrush x:Key="Brand.StatusError" Color="#F87171" />
      <SolidColorBrush x:Key="Brand.RecActive" Color="#F3686C" />
      <SolidColorBrush x:Key="Brand.RecPaused" Color="#F59E0B" />
      <SolidColorBrush x:Key="Brand.RecExporting" Color="#9B82FF" />
      <SolidColorBrush x:Key="Brand.RecExportComplete" Color="#10B981" />
      <SolidColorBrush x:Key="Brand.StateHover" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="Brand.StatePressed" Color="#1AFFFFFF" />
      <SolidColorBrush x:Key="Brand.StateSelected" Color="#2918DCE8" />
      <SolidColorBrush x:Key="Brand.StateFocusRing" Color="#18DCE8" />
      <SolidColorBrush x:Key="Brand.StateSelectionText" Color="#4C18DCE8" />
      <SolidColorBrush x:Key="Brand.StateDisabledFill" Color="#0AFFFFFF" />
      <SolidColorBrush x:Key="Brand.SurfaceOverlay" Color="#1B3042" />
      <SolidColorBrush x:Key="Brand.SurfaceScrim" Color="#B8050B14" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Brand.BgApp" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Brand.BgSecondary" Color="#F6F8FB" />
      <SolidColorBrush x:Key="Brand.SurfaceLayer1" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Brand.SurfaceLayer2" Color="#F1F5F9" />
      <SolidColorBrush x:Key="Brand.SurfaceLayer3" Color="#E8EEF4" />
      <SolidColorBrush x:Key="Brand.FgPrimary" Color="#111827" />
      <SolidColorBrush x:Key="Brand.FgSecondary" Color="#475569" />
      <SolidColorBrush x:Key="Brand.FgMuted" Color="#667182" />
      <SolidColorBrush x:Key="Brand.FgDisabled" Color="#A9B4C2" />
      <SolidColorBrush x:Key="Brand.BrandPrimary" Color="#087C88" />
      <SolidColorBrush x:Key="Brand.BrandPrimaryHover" Color="#066A76" />
      <SolidColorBrush x:Key="Brand.BrandPrimaryPressed" Color="#055C66" />
      <SolidColorBrush x:Key="Brand.BrandOnPrimary" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Brand.BrandSecondary" Color="#6941C6" />
      <SolidColorBrush x:Key="Brand.BrandSecondaryText" Color="#6941C6" />
      <SolidColorBrush x:Key="Brand.BrandSecondarySolid" Color="#6941C6" />
      <SolidColorBrush x:Key="Brand.BrandSecondaryOnSolid" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Brand.BorderSubtle" Color="#E2E8F0" />
      <SolidColorBrush x:Key="Brand.Divider" Color="#E9EEF3" />
      <SolidColorBrush x:Key="Brand.BorderControl" Color="#8191A8" />
      <SolidColorBrush x:Key="Brand.StatusInfo" Color="#2A6BDA" />
      <SolidColorBrush x:Key="Brand.StatusSuccess" Color="#047857" />
      <SolidColorBrush x:Key="Brand.StatusWarning" Color="#B45309" />
      <SolidColorBrush x:Key="Brand.StatusError" Color="#DA2323" />
      <SolidColorBrush x:Key="Brand.RecActive" Color="#DC1D23" />
      <SolidColorBrush x:Key="Brand.RecPaused" Color="#B45309" />
      <SolidColorBrush x:Key="Brand.RecExporting" Color="#6941C6" />
      <SolidColorBrush x:Key="Brand.RecExportComplete" Color="#047857" />
      <SolidColorBrush x:Key="Brand.StateHover" Color="#0D09111D" />
      <SolidColorBrush x:Key="Brand.StatePressed" Color="#1709111D" />
      <SolidColorBrush x:Key="Brand.StateSelected" Color="#1A087C88" />
      <SolidColorBrush x:Key="Brand.StateFocusRing" Color="#087C88" />
      <SolidColorBrush x:Key="Brand.StateSelectionText" Color="#38087C88" />
      <SolidColorBrush x:Key="Brand.StateDisabledFill" Color="#0A09111D" />
      <SolidColorBrush x:Key="Brand.SurfaceOverlay" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Brand.SurfaceScrim" Color="#6609111D" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
