<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Cap-IT desktop application: Avalonia presentation layer over CapIT.Core and the Windows
       recording engine. AssemblyName stays "ScreenRecorderApp" — the installer, Start Menu shortcuts,
       single-instance focus (process name) and the in-place updater all depend on ScreenRecorderApp.exe. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>ScreenRecorderApp</RootNamespace>
    <AssemblyName>ScreenRecorderApp</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\AppIcon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CapIT.Core\CapIT.Core.csproj" />
    <ProjectReference Include="..\CapIT.Infrastructure.Windows\CapIT.Infrastructure.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Win32" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.22" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\Logo-Mark.png" Link="Assets\Logo-Mark.png" />
    <AvaloniaResource Include="..\..\assets\AppIcon.ico" Link="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime files read from AppContext.BaseDirectory by the engine (click sounds, window icon). -->
    <None Include="..\..\assets\AppIcon.ico" Link="assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\Logo-Mark.png" Link="assets\Logo-Mark.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\sounds\*.*" Link="assets\sounds\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- ffmpeg.exe is a large third-party binary excluded from git (see ffmpeg/README.md) — the
         Condition keeps a fresh clone buildable before that file has been downloaded/placed locally. -->
    <None Include="..\..\ffmpeg\ffmpeg.exe" Link="ffmpeg\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\ffmpeg\ffmpeg.exe')" />
  </ItemGroup>
</Project>
