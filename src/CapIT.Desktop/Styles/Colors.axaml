<!--
  Semantic colour tokens for both themes, plus the Fluent control-resource keys that are redirected
  onto them so built-in controls (inputs, dropdowns, flyouts, scrollbars, tooltips) share one palette.
  Views only reference the semantic keys (Brush.*), never raw colours.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>

    <!-- ============================== DARK (flagship) ============================== -->
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="Color.Accent">#22CBDD</Color>
      <Color x:Key="Color.Shadow">#66000000</Color>

      <SolidColorBrush x:Key="Brush.BackgroundPrimary" Color="#0B0D11" />
      <SolidColorBrush x:Key="Brush.BackgroundSecondary" Color="#0E1015" />
      <SolidColorBrush x:Key="Brush.Surface" Color="#13161C" />
      <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="#191D24" />
      <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#1E232B" />
      <SolidColorBrush x:Key="Brush.SurfacePressed" Color="#252B34" />
      <SolidColorBrush x:Key="Brush.SurfaceSunken" Color="#0F1217" />
      <SolidColorBrush x:Key="Brush.Stage" Color="#07080B" />
      <SolidColorBrush x:Key="Brush.Overlay" Color="#B3050608" />
      <SolidColorBrush x:Key="Brush.Hover" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="Brush.Pressed" Color="#17FFFFFF" />

      <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#1C2129" />
      <SolidColorBrush x:Key="Brush.BorderNormal" Color="#272D36" />
      <SolidColorBrush x:Key="Brush.BorderStrong" Color="#38404B" />

      <SolidColorBrush x:Key="Brush.TextPrimary" Color="#E7EAEF" />
      <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A1A9B6" />
      <SolidColorBrush x:Key="Brush.TextMuted" Color="#6C7583" />
      <SolidColorBrush x:Key="Brush.TextDisabled" Color="#4A515C" />
      <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#03191C" />

      <SolidColorBrush x:Key="Brush.Accent" Color="#22CBDD" />
      <SolidColorBrush x:Key="Brush.AccentHover" Color="#47D6E5" />
      <SolidColorBrush x:Key="Brush.AccentPressed" Color="#1AB2C3" />
      <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#1A22CBDD" />
      <SolidColorBrush x:Key="Brush.AccentSubtleHover" Color="#2622CBDD" />
      <SolidColorBrush x:Key="Brush.AccentText" Color="#5EDCEA" />
      <SolidColorBrush x:Key="Brush.FocusRing" Color="#8022CBDD" />

      <SolidColorBrush x:Key="Brush.Success" Color="#3DD68C" />
      <SolidColorBrush x:Key="Brush.SuccessSubtle" Color="#1A3DD68C" />
      <SolidColorBrush x:Key="Brush.Warning" Color="#F5B83D" />
      <SolidColorBrush x:Key="Brush.WarningSubtle" Color="#1AF5B83D" />
      <SolidColorBrush x:Key="Brush.Error" Color="#F26D6D" />
      <SolidColorBrush x:Key="Brush.ErrorSubtle" Color="#1AF26D6D" />
      <SolidColorBrush x:Key="Brush.Info" Color="#6AA8FF" />
      <SolidColorBrush x:Key="Brush.InfoSubtle" Color="#1A6AA8FF" />
      <SolidColorBrush x:Key="Brush.Danger" Color="#E5484D" />
      <SolidColorBrush x:Key="Brush.DangerHover" Color="#EC5D61" />
      <SolidColorBrush x:Key="Brush.DangerPressed" Color="#C93D41" />
      <SolidColorBrush x:Key="Brush.Recording" Color="#F2555A" />
      <SolidColorBrush x:Key="Brush.MeterTrack" Color="#1C2129" />
      <SolidColorBrush x:Key="Brush.SegmentTrack" Color="#0D1014" />
      <SolidColorBrush x:Key="Brush.SliderThumbBorder" Color="#4D0B0D11" />
      <SolidColorBrush x:Key="Brush.SegmentSelected" Color="#232933" />
      <SolidColorBrush x:Key="Brush.Checker" Color="#0F1217" />

      <!-- Fluent: system accent family -->
