      <SolidColorBrush x:Key="TextControlButtonForeground" Color="#A1A9B6" />
      <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="#E7EAEF" />

      <!-- Fluent: dropdowns -->
      <SolidColorBrush x:Key="ComboBoxBackground" Color="#0F1217" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#151920" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#191D24" />
