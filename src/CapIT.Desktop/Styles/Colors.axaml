      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#1A22CBDD" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#2622CBDD" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#2622CBDD" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#E7EAEF" />
