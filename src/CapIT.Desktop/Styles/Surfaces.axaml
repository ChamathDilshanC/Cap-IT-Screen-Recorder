<!-- Window defaults, surfaces (cards, panels, insets, stage), dividers, key caps and input tweaks. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Brush.BackgroundPrimary}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
  </Style>

  <!-- Cards & panels -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Large}" />
    <Setter Property="Padding" Value="{StaticResource Pad.Card}" />
  </Style>
  <Style Selector="Border.card-flush">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Large}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Large}" />
  </Style>
  <Style Selector="Border.inset">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}" />
  </Style>
  <Style Selector="Border.stage">
    <Setter Property="Background" Value="{DynamicResource Brush.Stage}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Large}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.raised">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderNormal}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Large}" />
    <Setter Property="BoxShadow" Value="0 12 32 0 #40000000" />
  </Style>
  <Style Selector="Border.icon-tile">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
  </Style>
  <Style Selector="Border.icon-tile.accent">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
  </Style>

  <!-- Dividers -->
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.BorderSubtle}" />
  </Style>
  <Style Selector="Border.vdivider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.BorderSubtle}" />
  </Style>

  <!-- Keyboard key cap -->
  <Style Selector="Border.kbd">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderNormal}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="6,1,6,2" />
    <Setter Property="MinWidth" Value="22" />
  </Style>
  <Style Selector="Border.kbd > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- Callouts (inline notices) -->
  <Style Selector="Border.callout">
    <Setter Property="Background" Value="{DynamicResource Brush.InfoSubtle}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.callout.warning">
    <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
  </Style>
  <Style Selector="Border.callout.accent">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
  </Style>
  <Style Selector="Border.callout.error">
    <Setter Property="Background" Value="{DynamicResource Brush.ErrorSubtle}" />
  </Style>

  <!-- Inputs: shared sizing on top of the Fluent templates -->
  <Style Selector="ComboBox">
    <Setter Property="MinWidth" Value="200" />
    <Setter Property="MaxDropDownHeight" Value="360" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
  </Style>
  <Style Selector="ComboBox.fill">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ComboBox.control-column">
    <Setter Property="Width" Value="{StaticResource Width.ControlColumn}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="MinHeight" Value="{StaticResource Height.Default}" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource ProgressBarBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="Slider /template/ Thumb">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.SliderThumbBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
  </Style>

  <!-- Scroll content never hugs the scrollbar -->
  <Style Selector="ScrollViewer.page">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
  </Style>
</Styles>
