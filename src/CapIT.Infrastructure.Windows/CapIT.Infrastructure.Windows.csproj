<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows-only recording engine: DXGI / Windows Graphics Capture, D3D11 frame processing, WASAPI
       audio, FFmpeg encoding, global input hooks, Win32 annotation overlays and the updater. It has no
       dependency on any UI framework; hosts marshal back to their UI thread themselves. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>ScreenRecorderApp</RootNamespace>
    <AssemblyName>CapIT.Infrastructure.Windows</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CapIT.Core\CapIT.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.6.2" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
  </ItemGroup>
</Project>
