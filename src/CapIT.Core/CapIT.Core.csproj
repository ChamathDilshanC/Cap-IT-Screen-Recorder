<Project Sdk="Microsoft.NET.Sdk">
  <!-- Domain models, persistence, composition layout and FFmpeg-based export. No UI framework and no
       WinRT projections, so the regression checks and any host can reference it directly. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>ScreenRecorderApp</RootNamespace>
    <AssemblyName>CapIT.Core</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>
</Project>
